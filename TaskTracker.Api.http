@TaskTracker.Api_HostAddress = http://localhost:5184

GET {{TaskTracker.Api_HostAddress}}/weatherforecast/
Accept: application/json

###
### Get all tasks
GET {{TaskTracker.Api_HostAddress}}/api/tasks
Accept: application/json

### Get task 2
GET {{TaskTracker.Api_HostAddress}}/api/tasks/2
Accept: application/json

### Get task that does not exist
GET {{TaskTracker.Api_HostAddress}}/api/tasks/99
Accept: application/json

### Create a task
POST {{TaskTracker.Api_HostAddress}}/api/tasks
Content-Type: application/json

{
  "title": "Learn Angular",
  "description": "Week 7"
}

### Update task 2
PUT {{TaskTracker.Api_HostAddress}}/api/tasks/2
Content-Type: application/json

{
  "title": "Build TaskTracker API",
  "description": "Week 1 project, almost done",
  "isCompleted": true
}

### Delete task 3
DELETE {{TaskTracker.Api_HostAddress}}/api/tasks/3

### Delete task that does not exist
DELETE {{TaskTracker.Api_HostAddress}}/api/tasks/99